{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Inherit the fleet baseline from the Golden Repo. This explicit path is required
  // because the preset lives at .github/renovate.json5 rather than default.json.
  "extends": [
    "github>nwarila-platform/pdq-deploy-inventory//.github/renovate.json5"
  ],

  // First-party exception (owner decision 2026-09-15): the org builds, signs, and verifies this
  // image itself, so the seven-day third-party quarantine does not apply to its digest bumps.
  // The ADR-0004 amendment remains queued in FU4/CONVENTIONS.
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/nwarila-platform/workflow-template-drift"],
      "minimumReleaseAge": null
    }
  ],

  "customManagers": [
    {
      // Keep the release tag and immutable manifest digest synchronized in both
      // workflow execution sites.
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:reusable-template-drift\\.yaml|self-ci\\.yml)$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>ghcr\\.io/nwarila-platform/workflow-template-drift)\\r?\\n[ \\t]*image='ghcr\\.io/nwarila-platform/workflow-template-drift:(?<currentValue>[^@'\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ],
      "packageNameTemplate": "{{{depName}}}",
      "versioningTemplate": "docker"
    }
  ]
}
